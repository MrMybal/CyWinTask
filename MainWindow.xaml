<Window x:Class="CyWinTask.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CyWinTask" Icon="/CyWinTask;component/Assets/cywintask-logo-transparent.png" Title="CyWinTask — Gestionnaire des tâches" Width="1280" Height="800" MinWidth="1000" MinHeight="560" Background="{StaticResource CyBg1}" Foreground="{StaticResource CyText}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource CyBg0}" BorderBrush="{StaticResource CyLineStrong}" BorderThickness="0,0,1,0" Padding="18,22"><DockPanel>
<StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal"><Image Source="/CyWinTask;component/Assets/cywintask-logo-transparent.png" RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock Text="CyWinTask" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="GESTIONNAIRE DES TÂCHES" FontSize="10" Foreground="{StaticResource CyTextFaint}" Margin="0,8,0,35"/>
<TextBlock Text="NAVIGATION" Style="{StaticResource CyOverline}" Margin="8,0,0,12"/><Button x:Name="ProcessesTab" Style="{StaticResource CyNavButton}" Content="☷   Processus" ToolTip="Liste, recherche et inspection des processus" Click="Processes_Click" Background="{StaticResource CyAccentDim}" HorizontalContentAlignment="Left"/><Button x:Name="PerformanceTab" Style="{StaticResource CyNavButton}" Content="▥   Performance" ToolTip="Mesures CPU, mémoire, disques, réseau et GPU" Click="Performance_Click" HorizontalContentAlignment="Left"/>
<TextBlock Text="Vue système" Margin="14,30,0,14" Foreground="{StaticResource CyTextDim}"/><TextBlock x:Name="Machine" TextWrapping="Wrap" Margin="14,0,0,10"/><TextBlock x:Name="Cores" Margin="14,0,0,0" Foreground="{StaticResource CyTextDim}"/>
</StackPanel><StackPanel VerticalAlignment="Bottom"><TextBlock Text="NATIF · LOCAL · TEMPS RÉEL" FontSize="10" Foreground="{StaticResource CyTextDim}"/><TextBlock Text="Version 0.6.0" Margin="0,7,0,0" Foreground="{StaticResource CyTextFaint}"/></StackPanel></DockPanel></Border>
<Grid x:Name="ProcessPage" Grid.Column="1" Margin="24,22,24,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><StackPanel><TextBlock Text="Processus" Style="{StaticResource CyPageTitle}"/><TextBlock Text="Observez, retrouvez et inspectez ce qui s’exécute." Foreground="{StaticResource CyTextDim}" Margin="0,6,0,22"/></StackPanel><Button x:Name="PauseButton" Content="Ⅱ  Pause" Click="Pause_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/></DockPanel>
<UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
<Border Style="{StaticResource CyCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="PROCESSEUR" Foreground="{StaticResource CyTextDim}" FontSize="11"/><TextBlock x:Name="CpuTotal" Text="—" FontSize="29" Margin="0,7,0,0" Foreground="{StaticResource CyInfo}"/></StackPanel></Border>
<Border Style="{StaticResource CyCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="MÉMOIRE PHYSIQUE" Foreground="{StaticResource CyTextDim}" FontSize="11"/><TextBlock x:Name="MemoryTotal" Text="—" FontSize="29" Margin="0,7,0,0"/></StackPanel></Border>
<Border Style="{StaticResource CyCard}"><StackPanel><TextBlock Text="PROCESSUS" Foreground="{StaticResource CyTextDim}" FontSize="11"/><TextBlock x:Name="ProcessTotal" Text="—" FontSize="29" Margin="0,7,0,0"/></StackPanel></Border></UniformGrid>
<StackPanel Grid.Row="2"><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" x:Name="EndButton" Style="{StaticResource CyDangerButton}" Content="Arrêter la tâche" Click="End_Click" IsEnabled="False"/><Button DockPanel.Dock="Right" x:Name="InspectButton" IsEnabled="False" Content="Inspecter" Click="Inspect_Click"/><Grid><TextBox x:Name="Search" TextChanged="Search_Changed" ToolTip="Rechercher par nom ou PID · Ctrl+F" VerticalContentAlignment="Center" AutomationProperties.Name="Rechercher un processus"/><TextBlock x:Name="SearchHint" Text="Rechercher un processus ou un PID…" IsHitTestVisible="False" Foreground="{StaticResource CyTextFaint}" Margin="13,0" VerticalAlignment="Center"/></Grid></DockPanel>
<DockPanel Margin="0,0,0,14">
<CheckBox x:Name="TreeProcesses" DockPanel.Dock="Right" Content="Processus associés" ToolTip="Afficher les processus enfants sous leur parent" Foreground="{StaticResource CyText}" VerticalAlignment="Center" Margin="16,0,4,0" Checked="TreeMode_Changed" Unchecked="TreeMode_Changed"/><CheckBox x:Name="GroupProcesses" DockPanel.Dock="Right" Content="Regrouper par type" ToolTip="Séparer applications, tâches en arrière-plan et processus Windows" Foreground="{StaticResource CyText}" VerticalAlignment="Center" Margin="20,0,4,0" Checked="GroupOptions_Changed" Unchecked="GroupOptions_Changed"/>
<StackPanel Orientation="Horizontal"><TextBlock Text="Afficher :" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource CyTextDim}"/>
<ComboBox x:Name="CategoryFilter" Width="245" SelectedIndex="0" SelectionChanged="CategoryFilter_Changed" Padding="8,5" AutomationProperties.Name="Filtrer par type de processus">
<ComboBoxItem Tag=""><TextBlock Text="Tous les processus"/></ComboBoxItem>
<ComboBoxItem Tag="Applications"><TextBlock Text="Applications"/></ComboBoxItem>
<ComboBoxItem Tag="Processus en arrière-plan"><TextBlock Text="Processus en arrière-plan"/></ComboBoxItem>
<ComboBoxItem Tag="Processus Windows"><TextBlock Text="Processus Windows"/></ComboBoxItem>
</ComboBox></StackPanel></DockPanel><TextBlock x:Name="TreeHelp" Visibility="Collapsed" Text="▶ Déplier les enfants · tri entre branches · valeurs individuelles · arrêt des seules lignes sélectionnées" Foreground="{StaticResource CyTextFaint}" FontSize="11" Margin="0,0,0,10"/></StackPanel>
<Grid Grid.Row="3"><DataGrid x:Name="ProcessGrid" PreviewMouseRightButtonDown="ProcessGrid_RightClick" ContextMenuOpening="ProcessGrid_ContextOpening" CanUserSortColumns="True" Sorting="ProcessGrid_Sorting" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" Background="{StaticResource CyBg1}" RowBackground="{x:Null}" AlternatingRowBackground="{x:Null}" AlternationCount="2" Foreground="{StaticResource CyText}" BorderBrush="{StaticResource CyLineStrong}" BorderThickness="1" RowHeight="38" VirtualizingPanel.IsVirtualizingWhenGrouping="True" EnableRowVirtualization="True" EnableColumnVirtualization="False" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" SelectionChanged="Selection_Changed" MouseDoubleClick="Inspect_Click">
<DataGrid.ContextMenu><ContextMenu/></DataGrid.ContextMenu><DataGrid.RowStyle>
<Style TargetType="DataGridRow"><Setter Property="Background" Value="{StaticResource CyBg1}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow"><Grid Background="{TemplateBinding Background}"><Border Background="{Binding BranchBackground}" IsHitTestVisible="False"/><Border x:Name="SelectionFill" Background="{StaticResource CySelection}" Visibility="Collapsed" IsHitTestVisible="False"/><DataGridCellsPresenter SnapsToDevicePixels="True"/><Border HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False" SnapsToDevicePixels="True"/><Border x:Name="SelectionOutline" BorderBrush="{StaticResource CyAccentHover}" BorderThickness="3,1,1,1" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}" Visibility="Collapsed" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionFill" Property="Visibility" Value="Visible"/><Setter TargetName="SelectionOutline" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
<Setter Property="BorderThickness" Value="{Binding BranchBorder}"/>
<Setter Property="BorderBrush" Value="{StaticResource CyAccentDim}"/>
<Setter Property="SnapsToDevicePixels" Value="True"/>
<Style.Triggers>
<Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="{StaticResource CyBg2}"/></Trigger><DataTrigger Binding="{Binding InBranch}" Value="True"><Setter Property="Background" Value="{StaticResource CyBranch}"/></DataTrigger>
<DataTrigger Binding="{Binding IsBranchRoot}" Value="True"><Setter Property="Background" Value="{StaticResource CyBranchRoot}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
<Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource CySelection}"/></Trigger>
</Style.Triggers>
</Style>
</DataGrid.RowStyle><DataGrid.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="{StaticResource CyBg3}" Padding="12,10"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" Foreground="{StaticResource CyAccentHover}" FontWeight="SemiBold"/><TextBlock Text="{Binding ItemCount, StringFormat={}  ({0})}" Foreground="{StaticResource CyTextDim}"/></StackPanel></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></DataGrid.GroupStyle><DataGrid.Columns><DataGridTemplateColumn Header="Nom du processus" SortMemberPath="Name" CanUserSort="True" Width="330" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="{Binding TreeIndent}"><Button Content="{Binding ExpandGlyph}" Visibility="{Binding ExpandVisibility}" Width="19" Padding="0" Margin="0,0,5,0" Background="Transparent" Foreground="{StaticResource CyAccentHover}" Click="ExpandProcess_Click" ToolTip="Déplier / replier les processus enfants" AutomationProperties.Name="Processus enfants"/><Grid Width="18" Height="18" Margin="0,0,10,0"><TextBlock Text="▧" Foreground="{StaticResource CyTextFaint}" FontSize="16"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/><TextBlock Text="{Binding TreeLabel}" Foreground="{StaticResource CyInfo}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="PID" CanUserSort="True" SortMemberPath="Id" Binding="{Binding Id}" Width="80"/><DataGridTemplateColumn Header="CPU" CanUserSort="True" SortMemberPath="Cpu" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:UsageCell Percent="{Binding Cpu}" Label="{Binding Cpu, StringFormat={}{0:N1} %}" ToolTip="Part du CPU total : bleu &lt; 5 %, jaune ≥ 5 %, orange ≥ 20 %, rouge ≥ 50 %"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Mémoire" CanUserSort="True" SortMemberPath="MemoryMb" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:UsageCell Percent="{Binding MemoryPercent}" Label="{Binding MemoryLabel}" IsMemory="True" ToolTip="Part de la RAM physique totale : bleu &lt; 1 %, jaune ≥ 1 %, orange ≥ 4 %, rouge ≥ 10 %"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Threads" CanUserSort="True" SortMemberPath="Threads" Binding="{Binding Threads}" Width="85"/><DataGridTextColumn Header="Handles" CanUserSort="True" SortMemberPath="Handles" Binding="{Binding Handles}" Width="85"/></DataGrid.Columns>
</DataGrid><TextBlock x:Name="EmptyLabel" Text="Aucun processus ne correspond à la recherche." Foreground="{StaticResource CyTextDim}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
<Border x:Name="DetailPanel" Grid.Row="4" Visibility="Collapsed" Background="{StaticResource CyBg2}" Padding="16" Margin="0,14,0,0" CornerRadius="6"><DockPanel><Button DockPanel.Dock="Right" Content="Fermer" Click="CloseDetails_Click" VerticalAlignment="Top"/><TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MaxHeight="150" VerticalScrollBarVisibility="Auto"/></DockPanel></Border>
<DockPanel Grid.Row="5" Margin="0,12,0,0"><TextBlock x:Name="Status" Foreground="{StaticResource CyTextFaint}" FontSize="11"/><TextBlock Text="Ctrl+F · Ctrl / Maj : multisélection" HorizontalAlignment="Right" Foreground="{StaticResource CyTextFaint}" FontSize="11"/></DockPanel></Grid><local:PerformanceView x:Name="PerformancePage" Grid.Column="1" Visibility="Collapsed"/></Grid></Window>
