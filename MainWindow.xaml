<Window x:Class="CyWinTask.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CyWinTask" Icon="/CyWinTask;component/Assets/cywintask-logo-transparent.png" Title="CyWinTask — Gestionnaire des tâches" Width="1280" Height="800" MinWidth="1000" MinHeight="560" Background="#18181C" Foreground="#EEEEF4" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#202024" Padding="20,25"><DockPanel>
<StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal"><Image Source="/CyWinTask;component/Assets/cywintask-logo-transparent.png" RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" Width="28" Height="28" Margin="0,0,8,0"/><TextBlock Text="CyWinTask" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel><TextBlock Text="GESTIONNAIRE DES TÂCHES" FontSize="10" Foreground="#92929F" Margin="0,8,0,35"/>
<Button x:Name="ProcessesTab" Content="☷   Processus" Click="Processes_Click" Background="#2B424A" HorizontalContentAlignment="Left"/><Button x:Name="PerformanceTab" Content="▥   Performance" Click="Performance_Click" HorizontalContentAlignment="Left"/>
<TextBlock Text="Vue système" Margin="14,30,0,14" Foreground="#9999A6"/><TextBlock x:Name="Machine" TextWrapping="Wrap" Margin="14,0,0,10"/><TextBlock x:Name="Cores" Margin="14,0,0,0" Foreground="#9999A6"/>
</StackPanel><StackPanel VerticalAlignment="Bottom"><TextBlock Text="NATIF · LOCAL · TEMPS RÉEL" FontSize="10" Foreground="#9999A6"/><TextBlock Text="Version 0.5.3" Margin="0,7,0,0" Foreground="#71717E"/></StackPanel></DockPanel></Border>
<Grid x:Name="ProcessPage" Grid.Column="1" Margin="26,24,26,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel><StackPanel><TextBlock Text="Processus" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Observez, retrouvez et inspectez ce qui s’exécute." Foreground="#9999A6" Margin="0,6,0,22"/></StackPanel><Button x:Name="PauseButton" Content="Ⅱ  Pause" Click="Pause_Click" HorizontalAlignment="Right" VerticalAlignment="Top"/></DockPanel>
<UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
<Border Background="#23232A" CornerRadius="8" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="PROCESSEUR" Foreground="#A0A0AE" FontSize="11"/><TextBlock x:Name="CpuTotal" Text="—" FontSize="29" Margin="0,7,0,0" Foreground="#81DDEA"/></StackPanel></Border>
<Border Background="#23232A" CornerRadius="8" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="MÉMOIRE PHYSIQUE" Foreground="#A0A0AE" FontSize="11"/><TextBlock x:Name="MemoryTotal" Text="—" FontSize="29" Margin="0,7,0,0"/></StackPanel></Border>
<Border Background="#23232A" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="PROCESSUS" Foreground="#A0A0AE" FontSize="11"/><TextBlock x:Name="ProcessTotal" Text="—" FontSize="29" Margin="0,7,0,0"/></StackPanel></Border></UniformGrid>
<StackPanel Grid.Row="2"><DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" x:Name="EndButton" Content="Arrêter la tâche" Click="End_Click" IsEnabled="False"/><Button DockPanel.Dock="Right" Content="Inspecter" Click="Inspect_Click"/><Grid><TextBox x:Name="Search" TextChanged="Search_Changed" ToolTip="Rechercher par nom ou PID · Ctrl+F" VerticalContentAlignment="Center" AutomationProperties.Name="Rechercher un processus"/><TextBlock x:Name="SearchHint" Text="Rechercher un processus ou un PID…" IsHitTestVisible="False" Foreground="#92929F" Margin="13,0" VerticalAlignment="Center"/></Grid></DockPanel>
<DockPanel Margin="0,0,0,14">
<CheckBox x:Name="TreeProcesses" DockPanel.Dock="Right" Content="Processus associés" Foreground="#DDDEE8" VerticalAlignment="Center" Margin="16,0,4,0" Checked="TreeMode_Changed" Unchecked="TreeMode_Changed"/><CheckBox x:Name="GroupProcesses" DockPanel.Dock="Right" Content="Regrouper par type" Foreground="#DDDEE8" VerticalAlignment="Center" Margin="20,0,4,0" Checked="GroupOptions_Changed" Unchecked="GroupOptions_Changed"/>
<StackPanel Orientation="Horizontal"><TextBlock Text="Afficher :" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#AAAABB"/>
<ComboBox x:Name="CategoryFilter" Width="245" SelectedIndex="0" SelectionChanged="CategoryFilter_Changed" Padding="8,5" Foreground="Black" AutomationProperties.Name="Filtrer par type de processus">
<ComboBox.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#202024"/></Style></ComboBox.Resources><ComboBoxItem Tag="" Foreground="Black"><TextBlock Text="Tous les processus" Foreground="#202024"/></ComboBoxItem>
<ComboBoxItem Tag="Applications" Foreground="Black"><TextBlock Text="Applications" Foreground="#202024"/></ComboBoxItem>
<ComboBoxItem Tag="Processus en arrière-plan" Foreground="Black"><TextBlock Text="Processus en arrière-plan" Foreground="#202024"/></ComboBoxItem>
<ComboBoxItem Tag="Processus Windows" Foreground="Black"><TextBlock Text="Processus Windows" Foreground="#202024"/></ComboBoxItem>
</ComboBox></StackPanel></DockPanel><TextBlock x:Name="TreeHelp" Visibility="Collapsed" Text="▶ Déplier les enfants · tri entre branches · valeurs individuelles · arrêt des seules lignes sélectionnées" Foreground="#9292A2" FontSize="11" Margin="0,0,0,10"/></StackPanel>
<Grid Grid.Row="3"><DataGrid x:Name="ProcessGrid" PreviewMouseRightButtonDown="ProcessGrid_RightClick" ContextMenuOpening="ProcessGrid_ContextOpening" CanUserSortColumns="True" Sorting="ProcessGrid_Sorting" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None" Background="#1C1C21" RowBackground="{x:Null}" AlternatingRowBackground="{x:Null}" AlternationCount="2" Foreground="#E4E4ED" BorderThickness="0" RowHeight="37" VirtualizingPanel.IsVirtualizingWhenGrouping="True" EnableRowVirtualization="True" EnableColumnVirtualization="False" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" SelectionChanged="Selection_Changed" MouseDoubleClick="Inspect_Click">
<DataGrid.ContextMenu><ContextMenu/></DataGrid.ContextMenu><DataGrid.RowStyle>
<Style TargetType="DataGridRow"><Setter Property="Background" Value="#1C1C21"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRow"><Grid Background="{TemplateBinding Background}"><Border Background="{Binding BranchBackground}" IsHitTestVisible="False"/><Border x:Name="SelectionFill" Background="#624694" Visibility="Collapsed" IsHitTestVisible="False"/><DataGridCellsPresenter SnapsToDevicePixels="True"/><Border HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False" SnapsToDevicePixels="True"/><Border x:Name="SelectionOutline" BorderBrush="#F6D879" BorderThickness="3,1,1,1" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}" Visibility="Collapsed" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionFill" Property="Visibility" Value="Visible"/><Setter TargetName="SelectionOutline" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
<Setter Property="BorderThickness" Value="{Binding BranchBorder}"/>
<Setter Property="BorderBrush" Value="#8FB8C8"/>
<Setter Property="SnapsToDevicePixels" Value="True"/>
<Style.Triggers>
<Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#202026"/></Trigger><DataTrigger Binding="{Binding InBranch}" Value="True"><Setter Property="Background" Value="#202E37"/></DataTrigger>
<DataTrigger Binding="{Binding IsBranchRoot}" Value="True"><Setter Property="Background" Value="#304651"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
<Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#365D6B"/></Trigger>
</Style.Triggers>
</Style>
</DataGrid.RowStyle><DataGrid.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="#262D35" Padding="12,10"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" Foreground="#85DEEF" FontWeight="SemiBold"/><TextBlock Text="{Binding ItemCount, StringFormat={}  ({0})}" Foreground="#AAAABB"/></StackPanel></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></DataGrid.GroupStyle><DataGrid.Columns><DataGridTemplateColumn Header="Nom du processus" SortMemberPath="Name" CanUserSort="True" Width="330" MinWidth="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="{Binding TreeIndent}"><Button Content="{Binding ExpandGlyph}" Visibility="{Binding ExpandVisibility}" Width="19" Padding="0" Margin="0,0,5,0" Background="Transparent" Foreground="#85DEEF" Click="ExpandProcess_Click" ToolTip="Déplier / replier les processus enfants" AutomationProperties.Name="Processus enfants"/><Grid Width="18" Height="18" Margin="0,0,10,0"><TextBlock Text="▧" Foreground="#8599AC" FontSize="16"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image Source="{Binding Icon}" Stretch="Uniform"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/><TextBlock Text="{Binding TreeLabel}" Foreground="#8FC7D3" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="PID" CanUserSort="True" SortMemberPath="Id" Binding="{Binding Id}" Width="80"/><DataGridTemplateColumn Header="CPU" CanUserSort="True" SortMemberPath="Cpu" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:UsageCell Percent="{Binding Cpu}" Label="{Binding Cpu, StringFormat={}{0:N1} %}" ToolTip="Part du CPU total : bleu &lt; 5 %, jaune ≥ 5 %, orange ≥ 20 %, rouge ≥ 50 %"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Mémoire" CanUserSort="True" SortMemberPath="MemoryMb" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:UsageCell Percent="{Binding MemoryPercent}" Label="{Binding MemoryLabel}" IsMemory="True" ToolTip="Part de la RAM physique totale : bleu &lt; 1 %, jaune ≥ 1 %, orange ≥ 4 %, rouge ≥ 10 %"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Threads" CanUserSort="True" SortMemberPath="Threads" Binding="{Binding Threads}" Width="85"/><DataGridTextColumn Header="Handles" CanUserSort="True" SortMemberPath="Handles" Binding="{Binding Handles}" Width="85"/></DataGrid.Columns>
</DataGrid><TextBlock x:Name="EmptyLabel" Text="Aucun processus ne correspond à la recherche." HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
<Border x:Name="DetailPanel" Grid.Row="4" Visibility="Collapsed" Background="#25252C" Padding="16" Margin="0,14,0,0" CornerRadius="6"><DockPanel><Button DockPanel.Dock="Right" Content="Fermer" Click="CloseDetails_Click" VerticalAlignment="Top"/><TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MaxHeight="150" VerticalScrollBarVisibility="Auto"/></DockPanel></Border>
<DockPanel Grid.Row="5" Margin="0,12,0,0"><TextBlock x:Name="Status" Foreground="#9494A3" FontSize="11"/><TextBlock Text="Ctrl+F · Ctrl / Maj : multisélection" HorizontalAlignment="Right" Foreground="#777786" FontSize="11"/></DockPanel></Grid><local:PerformanceView x:Name="PerformancePage" Grid.Column="1" Visibility="Collapsed"/></Grid></Window>
