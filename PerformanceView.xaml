<UserControl x:Class="CyWinTask.PerformanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:CyWinTask">
<Grid Margin="24,24,24,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,20"><Button x:Name="Pause" DockPanel.Dock="Right" Content="Ⅱ  Pause" Click="Pause_Click" VerticalAlignment="Top"/><Button x:Name="OpenWindow" DockPanel.Dock="Right" Content="Fenêtre séparée" ToolTip="Ouvrir les graphiques dans une autre fenêtre" Click="OpenWindow_Click" VerticalAlignment="Top"/><Button x:Name="GraphMode" DockPanel.Dock="Right" Content="Vue graphiques" ToolTip="Afficher uniquement les courbes CPU, mémoire et GPU" Click="GraphMode_Click" VerticalAlignment="Top"/><StackPanel><TextBlock Text="Performance" Style="{StaticResource CyPageTitle}"/><TextBlock Text="Activité du système · historique des 60 dernières secondes" Foreground="{StaticResource CyTextDim}" Margin="0,6,0,0"/></StackPanel></DockPanel>
<Grid x:Name="DeviceLayout" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ListBox x:Name="Devices" Background="{StaticResource CyBg2}" BorderThickness="0" Foreground="{StaticResource CyText}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Device_Changed" Margin="0,0,20,0" AutomationProperties.Name="Ressources système">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CySelection}"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource CyAccent}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource CyAccentHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource CyTextDim}" FontSize="11" Margin="0,5,0,0" ToolTip="{Binding Subtitle}"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource CyInfo}" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<TextBlock x:Name="DeviceTitle" FontSize="24" Text="Chargement des compteurs…"/>
<TextBlock x:Name="DeviceDescription" TextWrapping="Wrap" Foreground="{StaticResource CyTextDim}" Margin="0,8,0,16"/>
<CheckBox x:Name="ShowCores" Content="Afficher les processeurs logiques" Foreground="{StaticResource CyText}" Margin="0,0,0,15" Checked="Cores_Changed" Unchecked="Cores_Changed" Visibility="Collapsed"/>
<StackPanel x:Name="CpuModePanel" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock Text="Disposition CPU :" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="CpuMode" Width="180" SelectedIndex="0" SelectionChanged="CpuMode_Changed"><ComboBoxItem><TextBlock Text="Compacte (Windows)" Foreground="{StaticResource CyText}"/></ComboBoxItem><ComboBoxItem><TextBlock Text="Détaillée" Foreground="{StaticResource CyText}"/></ComboBoxItem></ComboBox></StackPanel><WrapPanel x:Name="CombinedLegend" Margin="0,0,0,12"/><UniformGrid x:Name="Charts" Columns="1"/>
<TextBlock x:Name="DeviceNote" TextWrapping="Wrap" Foreground="{StaticResource CyTextFaint}" Margin="0,10,0,0" FontSize="11"/>
</StackPanel></ScrollViewer></Grid><local:GraphDashboard x:Name="Dashboard" Grid.Row="1" Visibility="Collapsed"/>
<TextBlock Grid.Row="2" x:Name="CollectionStatus" Text="Initialisation des compteurs Windows…" Foreground="{StaticResource CyTextDim}" FontSize="11" Margin="0,12,0,0"/>
</Grid></UserControl>
