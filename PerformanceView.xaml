<UserControl x:Class="CyWinTask.PerformanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Margin="24,24,24,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,20"><Button x:Name="Pause" DockPanel.Dock="Right" Content="Ⅱ  Pause" Click="Pause_Click" VerticalAlignment="Top"/><StackPanel><TextBlock Text="Performance" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Activité du système · historique des 60 dernières secondes" Foreground="#9999A6" Margin="0,6,0,0"/></StackPanel></DockPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ListBox x:Name="Devices" Background="#202024" BorderThickness="0" Foreground="#EEEEF4" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Device_Changed" Margin="0,0,20,0" AutomationProperties.Name="Ressources système">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" CornerRadius="5" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2B424A"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#7298A2"/><Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
<ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" Foreground="#A7A7B6" FontSize="11" Margin="0,5,0,0" ToolTip="{Binding Subtitle}"/><TextBlock Text="{Binding Summary}" Foreground="#81DDEA" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<TextBlock x:Name="DeviceTitle" FontSize="24" Text="Chargement des compteurs…"/>
<TextBlock x:Name="DeviceDescription" TextWrapping="Wrap" Foreground="#AAAAB7" Margin="0,8,0,16"/>
<CheckBox x:Name="ShowCores" Content="Afficher les processeurs logiques" Foreground="#DDDEE8" Margin="0,0,0,15" Checked="Cores_Changed" Unchecked="Cores_Changed" Visibility="Collapsed"/>
<StackPanel x:Name="CpuModePanel" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock Text="Disposition CPU :" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="CpuMode" Width="180" SelectedIndex="0" SelectionChanged="CpuMode_Changed"><ComboBoxItem><TextBlock Text="Compacte (Windows)" Foreground="#202024"/></ComboBoxItem><ComboBoxItem><TextBlock Text="Détaillée" Foreground="#202024"/></ComboBoxItem></ComboBox></StackPanel><WrapPanel x:Name="CombinedLegend" Margin="0,0,0,12"/><UniformGrid x:Name="Charts" Columns="1"/>
<TextBlock x:Name="DeviceNote" TextWrapping="Wrap" Foreground="#9696A5" Margin="0,10,0,0" FontSize="11"/>
</StackPanel></ScrollViewer></Grid>
<TextBlock Grid.Row="2" x:Name="CollectionStatus" Text="Initialisation des compteurs Windows…" Foreground="#9999A6" FontSize="11" Margin="0,12,0,0"/>
</Grid></UserControl>
