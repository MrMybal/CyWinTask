<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- WPF translation of CyUI's navy palette. WPF device-independent pixels provide DPI scaling. -->
  <SolidColorBrush x:Key="CyBg0" Color="#0A0E13"/><SolidColorBrush x:Key="CyBg1" Color="#0D1218"/><SolidColorBrush x:Key="CyBg2" Color="#111820"/><SolidColorBrush x:Key="CyBg3" Color="#18212C"/><SolidColorBrush x:Key="CyBg4" Color="#1F2A37"/><SolidColorBrush x:Key="CyBg5" Color="#263343"/>
  <SolidColorBrush x:Key="CyLine" Color="#1C2632"/><SolidColorBrush x:Key="CyLineStrong" Color="#283748"/>
  <SolidColorBrush x:Key="CyText" Color="#D9E2EC"/><SolidColorBrush x:Key="CyTextDim" Color="#A4B3C2"/><SolidColorBrush x:Key="CyTextFaint" Color="#8397AA"/>
  <SolidColorBrush x:Key="CyAccent" Color="#2D7FF9"/><SolidColorBrush x:Key="CyAccentHover" Color="#4A93FF"/><SolidColorBrush x:Key="CyAccentDim" Color="#1D4E7A"/><SolidColorBrush x:Key="CyAccentText" Color="#FFFFFF"/><SolidColorBrush x:Key="CySelection" Color="#294F78"/>
  <SolidColorBrush x:Key="CySuccess" Color="#65CCA9"/><SolidColorBrush x:Key="CyWarning" Color="#F2B84B"/><SolidColorBrush x:Key="CyError" Color="#E8747C"/><SolidColorBrush x:Key="CyInfo" Color="#70A8FA"/>
  <SolidColorBrush x:Key="CyErrorDim" Color="#4B2933"/><SolidColorBrush x:Key="CyErrorHover" Color="#643440"/>
  <SolidColorBrush x:Key="CyMemory" Color="#C792EA"/><SolidColorBrush x:Key="CyDisk" Color="#9CCC65"/><SolidColorBrush x:Key="CyNetwork" Color="#FFB74D"/>
  <SolidColorBrush x:Key="CyBranch" Color="#172534"/><SolidColorBrush x:Key="CyBranchRoot" Color="#20374D"/>
  <Style x:Key="CyOverline" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource CyTextDim}"/></Style>
  <Style x:Key="CyPageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource CyText}"/></Style>
  <Style x:Key="CyCard" TargetType="Border"><Setter Property="Background" Value="{StaticResource CyBg2}"/><Setter Property="BorderBrush" Value="{StaticResource CyLineStrong}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="16"/></Style>
</ResourceDictionary>
